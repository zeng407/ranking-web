{
  "version": 4,
  "fallbackOrigin": "none",
  "fallbackOriginNote": "Was \"laravel\". Nothing falls back any more: Go owns authentication, the account pages and password reset, so every route below is served by this frontend and Laravel is stopped. Rolling back means starting Laravel on another port (APP_PORT=8000) and setting this back to \"laravel\" — see docs/laravel-shutdown.md.",
  "frontendRoutes": [
    "/",
    "/hot",
    "/new",
    "/g/*",
    "/r/*",
    "/room/*",
    "/login",
    "/account",
    "/account/*",
    "/password/forgot",
    "/password/reset/*",
    "/zh-tw/",
    "/zh-tw/hot",
    "/zh-tw/new",
    "/zh-tw/g/*",
    "/zh-tw/r/*",
    "/zh-tw/room/*",
    "/zh-tw/login",
    "/zh-tw/account",
    "/zh-tw/account/*",
    "/zh-tw/password/forgot",
    "/zh-tw/password/reset/*",
    "/zh-tw/donate",
    "/zh-tw/tos",
    "/zh-tw/privacy",
    "/en/",
    "/en/hot",
    "/en/new",
    "/en/g/*",
    "/en/r/*",
    "/en/room/*",
    "/en/login",
    "/en/account",
    "/en/account/*",
    "/en/password/forgot",
    "/en/password/reset/*",
    "/en/donate",
    "/en/tos",
    "/en/privacy",
    "/ja/",
    "/ja/hot",
    "/ja/new",
    "/ja/g/*",
    "/ja/r/*",
    "/ja/room/*",
    "/ja/login",
    "/ja/account",
    "/ja/account/*",
    "/ja/password/forgot",
    "/ja/password/reset/*",
    "/ja/donate",
    "/ja/tos",
    "/ja/privacy"
  ],
  "backendRoutes": [
    "/api/v1/*",
    "/admin/*"
  ],
  "permanentRedirects": {
    "/donate": "/zh-tw/donate",
    "/tos": "/zh-tw/tos",
    "/privacy": "/zh-tw/privacy",
    "/lang/zh_TW/*": "/zh-tw/*",
    "/lang/en/*": "/en/*",
    "/lang/ja/*": "/ja/*"
  },
  "cachePolicy": {
    "html": "public, max-age=0",
    "assets": "public, max-age=31536000, immutable",
    "runtimeConfig": "no-store"
  }
}
