{
    auto_https off
}

# WebSocket subdomain for Soketi - 分離 HTTP 和 HTTPS
http://ws.2pick.app {
    reverse_proxy soketi:6001
    encode zstd gzip
}

https://ws.2pick.app {
    reverse_proxy soketi:6001
    encode zstd gzip
    tls internal
}

# Main app domain for Laravel - 分離 HTTP 和 HTTPS
http://2pick.app {
    root * /var/www/public
    php_fastcgi php-fpm:9000
    file_server
    encode zstd gzip

    @immutableAssets {
        path /js/* /css/*
        query id=*
    }

    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"
}

https://2pick.app {
    root * /var/www/public
    php_fastcgi php-fpm:9000
    file_server
    encode zstd gzip
    tls internal

    @immutableAssets {
        path /js/* /css/*
        query id=*
    }

    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"
}

# 所有其他存取返回 404
:80, :443 {
    respond 404
}